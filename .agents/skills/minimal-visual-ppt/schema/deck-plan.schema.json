{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://minimal-visual-ppt.local/deck-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "language",
    "source",
    "warnings",
    "style",
    "slides"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "foreground",
        "accent",
        "fontFace"
      ],
      "properties": {
        "background": {
          "$ref": "#/definitions/color"
        },
        "foreground": {
          "$ref": "#/definitions/color"
        },
        "accent": {
          "$ref": "#/definitions/color"
        },
        "fontFace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/definitions/slide"
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{6}$"
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "body",
        "layout",
        "image",
        "gradient",
        "animations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "type": {
          "enum": [
            "cover",
            "content",
            "data",
            "process",
            "comparison",
            "closing"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "layout": {
          "enum": [
            "L01",
            "L02",
            "L03",
            "L04",
            "L05",
            "L06"
          ]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "query",
            "keywords"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "query": {
              "type": "string"
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "localPath": {
              "type": "string"
            },
            "focalPoint": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "gradient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "width",
            "opacity",
            "position"
          ],
          "properties": {
            "mode": {
              "enum": [
                "fade-left",
                "fade-right",
                "fade-top",
                "soft-overlay"
              ]
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "position": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "animations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "effect",
              "trigger",
              "duration",
              "delay"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "effect": {
                "enum": [
                  "fade",
                  "float"
                ]
              },
              "trigger": {
                "enum": [
                  "on-click",
                  "with-previous",
                  "after-previous"
                ]
              },
              "duration": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10
              },
              "delay": {
                "type": "number",
                "minimum": 0,
                "maximum": 60
              }
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "labels"
          ],
          "properties": {
            "kind": {
              "enum": [
                "bar",
                "process",
                "comparison"
              ]
            },
            "labels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "unit": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "bar"
                  }
                }
              },
              "then": {
                "required": [
                  "values"
                ],
                "properties": {
                  "values": {}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "process"
                  }
                }
              },
              "then": {
                "properties": {
                  "labels": {
                    "maxItems": 6,
                    "type": "array"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "comparison"
                  }
                }
              },
              "then": {
                "required": [
                  "columns"
                ],
                "properties": {
                  "labels": {
                    "minItems": 2,
                    "maxItems": 4,
                    "type": "array"
                  },
                  "columns": {}
                }
              }
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "data"
            ],
            "properties": {
              "data": {}
            }
          },
          "then": {
            "properties": {
              "layout": {
                "const": "L06"
              }
            }
          }
        }
      ]
    }
  }
}
